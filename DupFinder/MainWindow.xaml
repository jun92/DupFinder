<Window x:Class="DupFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DupFinder"
        mc:Ignorable="d"
        Title="DupFinder - SHA-256 Duplicate Finder"
        Height="720"
        Width="1120"
        MinHeight="640"
        MinWidth="960"
        FontFamily="Segoe UI"
        Background="#0B1021" Icon="Assets/app.ico">
    <Window.Resources>
        <Color x:Key="AccentColor">#6C5CE7</Color>
        <Color x:Key="AccentDarkColor">#4C3EB0</Color>
        <Color x:Key="CardColor">#111729</Color>
        <Color x:Key="CardStrokeColor">#1E2C48</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#B9C4E6" />
        <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#E9EDFF" />

        <DropShadowEffect x:Key="SoftShadow" Color="#0A0F1F" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161F33" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Foreground" Value="#F7F9FF" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="14 10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#382D8F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A314B" />
                                <Setter Property="Foreground" Value="#7F8BAA" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Background" Value="#1C263D" />
            <Setter Property="Foreground" Value="#E9EDFF" />
            <Setter Property="Padding" Value="12 8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1021" Offset="0" />
                <GradientStop Color="#0E1830" Offset="0.5" />
                <GradientStop Color="#0E1F3A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle Grid.Column="1"
                       Grid.RowSpan="2"
                       Width="1"
                       Fill="#141D32"
                       Opacity="0.6" />

            <Grid Grid.ColumnSpan="3"
                  Margin="36 28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 0 0 16">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HeaderForegroundBrush}"
                               Text="Duplicate Hash Finder" />
                    <TextBlock FontSize="14"
                               Margin="0 4 0 0"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Text="두 개의 폴더를 비교해 SHA-256 해시가 같은 파일 목록을 찾아줍니다." />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 12">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Margin="8 0 0 0"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{StaticResource HeaderForegroundBrush}"
                                       Text="대상 폴더" />
                            <TextBlock Margin="10 0 0 0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Text="하위 디렉터리까지 재귀적으로 스캔합니다." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="0 0 10 0">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Margin="0 0 0 6"
                                       Text="폴더 A" />
                            <DockPanel>
                                <TextBox x:Name="FolderAPathTextBox"
                                         MinWidth="320"
                                         ToolTip="왼쪽 비교 대상 폴더"
                                         Text="" />
                                <Button x:Name="BrowseFolderAButton"
                                        Click="BrowseFolderAButton_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="8 0 0 0"
                                        Content="찾아보기" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="10 0 0 0">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       Margin="0 0 0 6"
                                       Text="폴더 B" />
                            <DockPanel>
                                <TextBox x:Name="FolderBPathTextBox"
                                         MinWidth="320"
                                         ToolTip="오른쪽 비교 대상 폴더"
                                         Text="" />
                                <Button x:Name="BrowseFolderBButton"
                                        Click="BrowseFolderBButton_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="8 0 0 0"
                                        Content="찾아보기" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 14 0 0" HorizontalAlignment="Right">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                    <Setter Property="Margin" Value="0 0 8 0" />
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="SwapButton"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="SwapButton_Click"
                                    Content="폴더 교체" />
                            <Button x:Name="ResetButton"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="ResetButton_Click"
                                    Content="초기화" />
                            <Button x:Name="ScanButton"
                                    Style="{StaticResource PillButtonStyle}"
                                    Click="ScanButton_Click"
                                    Content="해시 스캔 시작" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0 16 0 0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource HeaderForegroundBrush}"
                                       Text="중복 해시 결과" />
                            <Border Background="#1C263D" CornerRadius="12" Padding="10 4" Margin="12 0 0 0">
                                <TextBlock x:Name="StatusTag"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="대기 중" />
                            </Border>
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="12 0 0 0"
                                    Padding="8 6"
                                    Click="SaveButton_Click"
                                    Content="결과 저장" />
                            <ProgressBar x:Name="ScanProgressBar"
                                         Width="140"
                                         Height="8"
                                         Margin="12 0 0 0"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"
                                         Background="#131929"
                                         Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   x:Name="SummaryTextBlock"
                                   Margin="0 6 0 12"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   Text="아직 스캔하지 않았습니다. 두 폴더를 선택한 뒤 스캔을 시작하세요." />

                        <TextBlock Grid.Row="2"
                                   x:Name="CurrentScanText"
                                   Margin="0 0 0 12"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Text="" />

                        <DataGrid Grid.Row="3"
                                  x:Name="ResultsGrid"
                                  ItemsSource="{Binding Results}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="None"
                                  RowBackground="#121A2C"
                                  AlternatingRowBackground="#0F1524"
                                  Foreground="#E9EDFF"
                                  BorderThickness="0"
                                  Background="#0F1524">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#131C2F" />
                                    <Setter Property="Foreground" Value="#C8D3F2" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderThickness" Value="0 0 0 1" />
                                    <Setter Property="BorderBrush" Value="#1E2C48" />
                                    <Setter Property="Padding" Value="10 8" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Hash}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="FontFamily" Value="Consolas" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="경로 (A / B)" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Padding="4 2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalContentAlignment="Left"
                                                        Click="OpenPathButton_Click"
                                                        CommandParameter="{Binding PathA, Mode=OneWay}">
                                                    <Button.Resources>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Setter Property="Foreground" Value="#8FB4FF" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="#8FB4FF"
                                                                                   FontSize="12"
                                                                                   FontFamily="Consolas" />
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Resources>
                                                    <Button.Content>
                                                        <TextBlock>
                                                            <Run Text="[A] " Foreground="#C8D3F2" FontWeight="SemiBold" />
                                                            <Run Text="{Binding PathA, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Button.Content>
                                                </Button>
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Padding="4 2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalContentAlignment="Left"
                                                        Click="OpenPathButton_Click"
                                                        CommandParameter="{Binding PathB, Mode=OneWay}">
                                                    <Button.Resources>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Setter Property="Foreground" Value="#8FB4FF" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="#8FB4FF"
                                                                                   FontSize="12"
                                                                                   FontFamily="Consolas" />
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Resources>
                                                    <Button.Content>
                                                        <TextBlock>
                                                            <Run Text="[B] " Foreground="#C8D3F2" FontWeight="SemiBold" />
                                                            <Run Text="{Binding PathB, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="크기" Binding="{Binding SizeDisplay}" Width="*" />
                                <DataGridTemplateColumn Header="유지 선택" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <StackPanel.Resources>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Margin" Value="0 0 6 0" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Button Content="A 유지"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="10 6"
                                                        Tag="A"
                                                        Click="KeepPathButton_Click"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="B 유지"
                                                        Style="{StaticResource PillButtonStyle}"
                                                        Padding="10 6"
                                                        Tag="B"
                                                        Click="KeepPathButton_Click"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

